# ---- Strapi (content) -------------------------------------------------------
NEXT_PUBLIC_STRAPI_API_URL=https://personal-blog-strapi-9oks.onrender.com
# Read-only API token. Server-side code prefers STRAPI_API_TOKEN; the NEXT_PUBLIC_
# variant is still read by the legacy CMS page components.
STRAPI_API_TOKEN=
NEXT_PUBLIC_STRAPI_API_TOKEN=
NEXT_PUBLIC_STRAPI_FORM_SUBMISSION_TOKEN=
NEXT_PUBLIC_PAGE_LIMIT=6

# ---- Agent (Vercel AI Gateway) ---------------------------------------------
# Team-scoped key from https://vercel.com/<team>/~/ai-gateway/api-keys
# Claude 5 models require paid credits on the Gateway account.
AI_GATEWAY_API_KEY=
# Optional model routing overrides (defaults shown). Fallbacks are tried by the
# Gateway in order when the primary model is unavailable.
# AGENT_MODEL_FAST=anthropic/claude-sonnet-5
# AGENT_MODEL_DEEP=anthropic/claude-opus-5
# AGENT_MODEL_FAST_FALLBACKS=anthropic/claude-sonnet-4.6,anthropic/claude-haiku-4.5
# AGENT_MODEL_DEEP_FALLBACKS=anthropic/claude-opus-4.6,anthropic/claude-sonnet-4.6

# ---- MCP App widget ---------------------------------------------------------
# Public origin used to self-fetch /mcp-app for the ui:// resource. Derived from
# VERCEL_PROJECT_PRODUCTION_URL on Vercel; set it for tunnels (ngrok) locally.
# NEXT_PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
